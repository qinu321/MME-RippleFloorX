////////////////////////////////////////////////////////////////////////////////
//
//  RF_FootRipple.fxsub   ver 2.2
//
//  Per model foot contact reporter for RippleFloorX.fx.
//
//  This file does NOT draw ripples.  While a foot is on the floor it writes a
//  small marker blob into the offscreen buffer declared by RippleFloorX.fx:
//
//    slot   : model pair * 2 + side, 0..15   (a 4 x 4 px blob, 4 px above the
//              bottom edge, one slot every 1/32 of the width; the pair id comes
//    colour : (local x, local z, 0, 1)  - the contact point in floor local
//              units.  The buffer is a float render target, so the position is
//              exact (no 8 bit encoding, no clamped range).
//
//  RippleFloorX.fx reads the blobs, keeps the 32 state rows and draws the
//  rings, so a ripple keeps expanding for 5 seconds after the touch.
//
////////////////////////////////////////////////////////////////////////////////

// ---------------------------------------------------------------- tuning
#define CONTACT_RATE  0.20    // contact when sole height < rate * shin length
#define FOOT_THICK    0.22    // ankle height above the sole (x shin length)
#define FOOT_SLOTS    16
#define MODEL_BUCKET  16.0    // world XZ bucket (local unit) used as a model id
#define STRIP_SLOTS   32      // marker strip width, 1/32 of the buffer per slot

// ---------------------------------------------------------------- floor
float4x4 FloorWorld   : CONTROLOBJECT < string name = "(OffscreenOwner)"; >;
float2   ViewportSize : VIEWPORTPIXELSIZE;

// model id for the slot.  VertexCount / SubsetCount separate different models,
// and the coarse world XZ of the root bone separates several copies of the
// SAME model (MME has no per-object index, and identical copies share both
// counts).  If two models still share a slot, change MODEL_BUCKET above so they
// fall into different buckets, or move them apart by more than one bucket.
int    VertexCount;
int    SubsetCount;

// placement anchor.  "全ての親" (the root bone) is the right one: it carries the
// model placement and is not moved by the dance, unlike センター.
float3 RootBone : CONTROLOBJECT < string name = "(self)"; string item = "全ての親"; >;
float3 HipBone  : CONTROLOBJECT < string name = "(self)"; string item = "センター"; >;

// ---------------------------------------------------------------- bones
float3 AnkleR : CONTROLOBJECT < string name = "(self)"; string item = "右足首"; >;
float3 AnkleL : CONTROLOBJECT < string name = "(self)"; string item = "左足首"; >;
float3 KneeR  : CONTROLOBJECT < string name = "(self)"; string item = "右ひざ"; >;
float3 KneeL  : CONTROLOBJECT < string name = "(self)"; string item = "左ひざ"; >;
float3 ToeR   : CONTROLOBJECT < string name = "(self)"; string item = "右つま先"; >;
float3 ToeL   : CONTROLOBJECT < string name = "(self)"; string item = "左つま先"; >;

////////////////////////////////////////////////////////////////////////////////

float3 FloorOrigin()
{
    return float3(FloorWorld._41, FloorWorld._42, FloorWorld._43);
}

float3 FloorAxisX()
{
    return normalize(float3(FloorWorld._11, FloorWorld._12, FloorWorld._13));
}

float3 FloorAxisY()
{
    return normalize(float3(FloorWorld._21, FloorWorld._22, FloorWorld._23));
}

float3 FloorAxisZ()
{
    return normalize(float3(FloorWorld._31, FloorWorld._32, FloorWorld._33));
}

float ShinLength()
{
    float legR = (length(AnkleR) > 0.001 && length(KneeR) > 0.001) ? distance(AnkleR, KneeR) : 0.0;
    float legL = (length(AnkleL) > 0.001 && length(KneeL) > 0.001) ? distance(AnkleL, KneeL) : 0.0;
    return clamp(max(legR, legL), 1.0, 100.0);
}

// true while the sole of foot k is close enough to the floor plane
bool FootContact(int k)
{
    float3 ankle = (k == 0) ? AnkleR : AnkleL;
    float3 toe   = (k == 0) ? ToeR   : ToeL;

    float3 o  = FloorOrigin();
    float3 ny = FloorAxisY();
    float  len = ShinLength();

    float h = 1.0e9;
    if (length(toe)   > 0.001) h = min(h, dot(toe   - o, ny));
    if (length(ankle) > 0.001) h = min(h, dot(ankle - o, ny) - FOOT_THICK * len);

    return (h < CONTACT_RATE * len);
}

// contact point of foot k, projected onto the floor plane, in floor local units
float2 FootLocal(int k)
{
    float3 ankle = (k == 0) ? AnkleR : AnkleL;
    float3 toe   = (k == 0) ? ToeR   : ToeL;
    float3 a = (length(ankle) > 0.001) ? ankle : toe;

    float3 o  = FloorOrigin();
    float3 nx = FloorAxisX();
    float3 ny = FloorAxisY();
    float3 nz = FloorAxisZ();

    float3 g = a - ny * dot(a - o, ny);

    // world -> floor local units (accessory Si is baked into FloorWorld)
    float fs = max(length(float3(FloorWorld._11, FloorWorld._12, FloorWorld._13)), 0.0001);
    return float2(dot(g - o, nx), dot(g - o, nz)) / fs;
}

////////////////////////////////////////////////////////////////////////////////

struct VS_OUT
{
    float4 Pos   : POSITION;
    float4 Color : COLOR0;
};

VS_OUT Marker_VS(float2 Tex : TEXCOORD0, uniform bool IsLeft)
{
    VS_OUT Out = (VS_OUT)0;

    int  k = IsLeft ? 1 : 0;
    bool contact = FootContact(k);

    // 16 slots = 8 model pairs; the pair comes from the model id above
    float3 anchor = RootBone;
    if (dot(anchor, anchor) < 1.0e-6) anchor = HipBone;

    // both horizontal axes: a row along X and a row along Z both give distinct
    // buckets (Z is weighted by 3 so the two axes do not collapse into one)
    int bx = (int)floor(anchor.x / MODEL_BUCKET);
    int bz = (int)floor(anchor.z / MODEL_BUCKET);
    int posBucket = (bx + 3 * bz + 512) % (FOOT_SLOTS / 2);

    int pairId = (VertexCount / 8 + SubsetCount + posBucket) % (FOOT_SLOTS / 2);
    int slot   = pairId * 2 + k;

    // slot centre, 4 px above the bottom edge (RippleFloorX.fx samples there)
    float u = (slot + 0.5) / STRIP_SLOTS;
    float v = 1.0 - 4.0 / ViewportSize.y;
    float2 c = float2(u * 2.0 - 1.0, 1.0 - 2.0 * v);

    // 4 x 4 px blob, collapsed when the foot is in the air
    float2 s = Tex.xy * 2.0 - 1.0;
    if (!contact) s = float2(0.0, 0.0);

    float hx = 4.0 / ViewportSize.x;
    float hy = 4.0 / ViewportSize.y;

    Out.Pos = float4(c.x + s.x * hx, c.y + s.y * hy, 0.0, 1.0);

    // the contact point, straight into the float buffer
    float2 l = FootLocal(k);
    Out.Color = float4(l.x, l.y, 0.0, contact ? 1.0 : 0.0);
    return Out;
}

float4 Marker_PS(VS_OUT IN) : COLOR0
{
    return IN.Color;
}

////////////////////////////////////////////////////////////////////////////////

technique MainTec < string MMDPass = "object"; string Subset = "0"; >
{
    pass MarkerRight < string Script = "Draw=Buffer;";>
    {
        ZENABLE          = FALSE;
        ZWRITEENABLE     = FALSE;
        ALPHABLENDENABLE = FALSE;
        CULLMODE         = NONE;
        VertexShader     = compile vs_3_0 Marker_VS(false);
        PixelShader      = compile ps_3_0 Marker_PS();
    }
    pass MarkerLeft < string Script = "Draw=Buffer;";>
    {
        ZENABLE          = FALSE;
        ZWRITEENABLE     = FALSE;
        ALPHABLENDENABLE = FALSE;
        CULLMODE         = NONE;
        VertexShader     = compile vs_3_0 Marker_VS(true);
        PixelShader      = compile ps_3_0 Marker_PS();
    }
}

technique MainTecSS < string MMDPass = "object_ss"; string Subset = "0"; >
{
    pass MarkerRight < string Script = "Draw=Buffer;";>
    {
        ZENABLE          = FALSE;
        ZWRITEENABLE     = FALSE;
        ALPHABLENDENABLE = FALSE;
        CULLMODE         = NONE;
        VertexShader     = compile vs_3_0 Marker_VS(false);
        PixelShader      = compile ps_3_0 Marker_PS();
    }
    pass MarkerLeft < string Script = "Draw=Buffer;";>
    {
        ZENABLE          = FALSE;
        ZWRITEENABLE     = FALSE;
        ALPHABLENDENABLE = FALSE;
        CULLMODE         = NONE;
        VertexShader     = compile vs_3_0 Marker_VS(true);
        PixelShader      = compile ps_3_0 Marker_PS();
    }
}

// suppress every other pass of the model inside the offscreen buffer
technique MainTecEmpty   < string MMDPass = "object";    > { }
technique MainTecSSEmpty < string MMDPass = "object_ss"; > { }
technique EdgeTec        < string MMDPass = "edge";      > { }
technique ShadowTec      < string MMDPass = "shadow";    > { }
technique ZplotTec       < string MMDPass = "zplot";     > { }
