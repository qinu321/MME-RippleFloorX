////////////////////////////////////////////////////////////////////////////////
//
//  RF_FootRipple.fxsub   ver 0.1
//
//  Per model part of RippleFloorX.fx.
//  Auto assigned to every PMD / PMX by the DefaultEffect list of the
//  offscreen buffer declared in RippleFloorX.fx.
//
//  Stateless: the ring is recomputed every frame from
//    - the foot bones of this model        : CONTROLOBJECT (self)
//    - the transform of the floor accessory: CONTROLOBJECT (OffscreenOwner)
//
//  Height -> position / size / alpha, in the same spirit as WF_XxShadow:
//    foot on the floor  : small ring, bright, right under the foot
//    foot lifted        : ring slides out, grows and fades
//
////////////////////////////////////////////////////////////////////////////////

// ---------------------------------------------------------------- tuning
#define RING_BASE     0.35    // base radius (x leg length)
#define RING_GROW     0.55    // extra radius at full lift (x leg length)
#define RING_LIFT     0.30    // lift for full growth (x leg length)
#define RING_FADE     0.55    // lift at which the ring fades out (x leg length)
#define RING_ALPHA    1.00
#define RING_WIDTH    0.075   // ring half width in quad units
#define CORE_GLOW     0.35
#define SLANT_X       0.55    // horizontal slide per lift (x foot height)
#define SLANT_Z       0.15
#define FOOT_THICK    0.22    // ankle height above the sole (x leg length)

// ---------------------------------------------------------------- floor
float4x4 FloorWorld     : CONTROLOBJECT < string name = "(OffscreenOwner)"; >;
float4x4 ViewProjMatrix : VIEWPROJECTION;
float    CurTime        : TIME < bool SyncInEditMode = true; >;

// ---------------------------------------------------------------- bones
// standard humanoid bones; missing bones return (0,0,0) and are ignored
float3 AnkleR : CONTROLOBJECT < string name = "(self)"; string item = "‰E‘«Žñ"; >;
float3 AnkleL : CONTROLOBJECT < string name = "(self)"; string item = "¶‘«Žñ"; >;
float3 KneeR  : CONTROLOBJECT < string name = "(self)"; string item = "‰E‚Ð‚´"; >;
float3 KneeL  : CONTROLOBJECT < string name = "(self)"; string item = "¶‚Ð‚´"; >;
float3 ToeR   : CONTROLOBJECT < string name = "(self)"; string item = "‰E‚Â‚Üæ"; >;
float3 ToeL   : CONTROLOBJECT < string name = "(self)"; string item = "¶‚Â‚Üæ"; >;

////////////////////////////////////////////////////////////////////////////////

struct VS_OUTPUT
{
    float4 Pos  : POSITION;
    float2 Tex  : TEXCOORD0;
    float4 Info : TEXCOORD1;   // x: alpha  y: radius  z: contact glow
};

VS_OUTPUT DrawRipple_VS(float2 Tex : TEXCOORD0, uniform bool IsLeft)
{
    VS_OUTPUT Out = (VS_OUTPUT)0;

    // ---- floor basis
    float3 floorO = float3(FloorWorld._41, FloorWorld._42, FloorWorld._43);
    float3 floorX = normalize(float3(FloorWorld._11, FloorWorld._12, FloorWorld._13));
    float3 floorY = normalize(float3(FloorWorld._21, FloorWorld._22, FloorWorld._23));
    float3 floorZ = normalize(float3(FloorWorld._31, FloorWorld._32, FloorWorld._33));

    // ---- this side
    float3 ankle = IsLeft ? AnkleL : AnkleR;
    float3 toe   = IsLeft ? ToeL   : ToeR;

    bool hasAnkle = length(ankle) > 0.001;
    bool hasToe   = length(toe)   > 0.001;

    // ---- model scale
    float legR = (length(AnkleR) > 0.001 && length(KneeR) > 0.001) ? distance(AnkleR, KneeR) : 0.0;
    float legL = (length(AnkleL) > 0.001 && length(KneeL) > 0.001) ? distance(AnkleL, KneeL) : 0.0;
    float legLen = clamp(max(legR, legL), 1.0, 100.0);

    // ---- sole height above the floor plane
    float h = 1.0e9;
    if (hasToe)   h = min(h, dot(toe   - floorO, floorY));
    if (hasAnkle) h = min(h, dot(ankle - floorO, floorY) - FOOT_THICK * legLen);

    bool   valid  = (h < 1.0e8);
    float  hh     = max(h, 0.0);
    float3 anchor = hasAnkle ? ankle : toe;

    // ---- ring parameters (height driven)
    float t       = saturate(hh / (legLen * RING_LIFT));
    float r       = legLen * (RING_BASE + RING_GROW * t);
    float a       = saturate(1.0 - hh / (legLen * RING_FADE)) * RING_ALPHA;
    float contact = saturate(1.0 - hh / (legLen * 0.10));

    // ---- center on the floor plane, slide out as the foot rises
    float3 center = anchor - floorY * dot(anchor - floorO, floorY);
    center += (floorX * SLANT_X + floorZ * SLANT_Z) * hh;

    if (!valid || a <= 0.001)
    {
        r = 0.0;
        a = 0.0;
        contact = 0.0;
    }

    // ---- floor aligned quad
    float2 s  = Tex.xy * 2.0 - 1.0;
    float3 wp = center + (floorX * s.x + floorZ * s.y) * (r * 2.0);

    Out.Pos  = mul(float4(wp, 1.0), ViewProjMatrix);
    Out.Tex  = Tex.xy;
    Out.Info = float4(a, r, contact, 0.0);
    return Out;
}

float4 DrawRipple_PS(VS_OUTPUT IN) : COLOR0
{
    float2 p = IN.Tex * 2.0 - 1.0;
    float  d = length(p);

    // soft ring at half of the quad (world radius = r)
    float ring = 1.0 - smoothstep(RING_WIDTH * 0.35, RING_WIDTH, abs(d - 0.5));

    // contact glow inside the ring
    float core = saturate(1.0 - d / 0.45);
    core *= core;

    float pulse = 0.85 + 0.15 * sin(CurTime * 3.0);
    float shape = ring * pulse + core * IN.Info.z * CORE_GLOW;

    float alpha = saturate(IN.Info.x * shape);
    return float4(alpha, alpha, alpha, 1.0);
}

////////////////////////////////////////////////////////////////////////////////

technique MainTec < string MMDPass = "object"; string Subset = "0"; >
{
    pass DrawRight < string Script = "Draw=Buffer;";> {
        ZENABLE          = FALSE;
        ZWRITEENABLE     = FALSE;
        ALPHABLENDENABLE = TRUE;
        SrcBlend         = ONE;
        DestBlend        = ONE;
        CULLMODE         = NONE;
        VertexShader     = compile vs_3_0 DrawRipple_VS(false);
        PixelShader      = compile ps_3_0 DrawRipple_PS();
    }
    pass DrawLeft < string Script = "Draw=Buffer;";> {
        ZENABLE          = FALSE;
        ZWRITEENABLE     = FALSE;
        ALPHABLENDENABLE = TRUE;
        SrcBlend         = ONE;
        DestBlend        = ONE;
        CULLMODE         = NONE;
        VertexShader     = compile vs_3_0 DrawRipple_VS(true);
        PixelShader      = compile ps_3_0 DrawRipple_PS();
    }
}

technique MainTecSS < string MMDPass = "object_ss"; string Subset = "0"; >
{
    pass DrawRight < string Script = "Draw=Buffer;";> {
        ZENABLE          = FALSE;
        ZWRITEENABLE     = FALSE;
        ALPHABLENDENABLE = TRUE;
        SrcBlend         = ONE;
        DestBlend        = ONE;
        CULLMODE         = NONE;
        VertexShader     = compile vs_3_0 DrawRipple_VS(false);
        PixelShader      = compile ps_3_0 DrawRipple_PS();
    }
    pass DrawLeft < string Script = "Draw=Buffer;";> {
        ZENABLE          = FALSE;
        ZWRITEENABLE     = FALSE;
        ALPHABLENDENABLE = TRUE;
        SrcBlend         = ONE;
        DestBlend        = ONE;
        CULLMODE         = NONE;
        VertexShader     = compile vs_3_0 DrawRipple_VS(true);
        PixelShader      = compile ps_3_0 DrawRipple_PS();
    }
}

// suppress every other pass of the model inside the offscreen buffer
technique MainTecEmpty   < string MMDPass = "object";    > { }
technique MainTecSSEmpty < string MMDPass = "object_ss"; > { }
technique EdgeTec        < string MMDPass = "edge";      > { }
technique ShadowTec      < string MMDPass = "shadow";    > { }
technique ZplotTec       < string MMDPass = "zplot";     > { }
